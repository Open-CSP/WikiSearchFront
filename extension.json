{
  "name": "WikiSearchFront",
  "author": "Robis Koopmans",
  "version": "4.0.0",
  "url": "https://www.wikibase-solutions.com",
  "descriptionmsg": "wikisearchfront-desc",
  "license-name": "GPL-2.0-or-later",
  "type": "parserhook",
  "MessagesDirs": {
    "WikiSearchFront": [
      "i18n"
    ]
  },
  "requires": {
    "MediaWiki": ">= 1.35.0",
    "extensions": {
      "WikiSearch": ">= 8.0.0"
    }
  },
  "ResourceModules": {
    "ext.WikiSearchFront.module": {
      "packageFiles": [
        "module/init.js",
        "src/App.vue",
        "src/store/index.js",
        "src/utilities/stringUtils.js",
        "src/utilities/dateUtils.js",
        "src/utilities/elastic.js",
        "src/components/Icon.vue",
        "src/components/Button.vue",
        "src/components/Checkbox.vue",
        "src/components/Tooltip.vue",
        "src/components/Input.vue",
        "src/components/ListBox.vue",
        "src/components/Dropdown.vue",
        "src/components/Pill.vue",
        "src/components/DateInput.vue",
        "src/components/SearchInput.vue",
        "src/components/PillsSelected.vue",
        "src/components/SortOrder.vue",
        "src/components/Pagers.vue",
        "src/components/CalendarTools.vue",
        "src/components/CalendarDialog.vue",
        "src/components/ResultProperty.vue",
        "src/components/WikiTemplate.vue",
        "src/components/filters/FacetCheckbox.vue",
        "src/components/filters/FacetCombobox.vue",
        "src/components/filters/FacetSearch.vue",
        "src/components/filters/FacetSwitch.vue",
        "src/components/filters/FacetDateRange.vue",
        "src/components/filters/FacetRangeSlider.vue",
        "src/components/filters/FacetAskCombobox.vue",
        "src/components/filters/FacetElasticCombobox.vue",
        "src/components/filters/FacetSorted.vue",
        "src/components/filters/FacetFilter.vue",
        "src/components/results/Results.vue",
        "src/components/results/ResultsCalendar.vue",
        "src/components/results/ResultsCalendarYear.vue",
        "src/components/results/ResultsTemplate.vue"
      ],
      "dependencies": [
        "vue",
        "moment"
      ],
      "messages": [
        "search",
        "wikisearchfront-date-range-from",
        "wikisearchfront-date-range-to",
        "wikisearchfront-clear-all-filters",
        "wikisearchfront-total-eq",
        "wikisearchfront-total-gte",
        "wikisearchfront-total-lte",
        "wikisearchfront-less",
        "wikisearchfront-more",
        "wikisearchfront-order",
        "wikisearchfront-score",
        "wikisearchfront-false",
        "wikisearchfront-true",
        "wikisearchfront-all",
        "wikisearchfront-page",
        "wikisearchfront-info"
      ]
    }
  },
  "AutoloadNamespaces": {
    "WikiSearchFront\\": "includes/"
  },
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteExtPath": "WikiSearchFront"
  },
  "AutoloadClasses": {
    "WikiSearchFrontHooks": "includes/WikiSearchFrontHooks.php"
  },
  "Hooks": {
    "WikiSearchOnLoadFrontend": "WikiSearchFront\\WikiSearchFrontHooks::onWikiSearchOnLoadFrontend"
  },
  "manifest_version": 2
}
